{
    "name": "zazuberlin/sitepackage",
    "type": "project",
    "description": "This is the general TYPO3 page setup from 2025. It includes bsggerapackage.",
    "authors": [
        {
            "name": "Thomas Hezel",
            "role": "Developer",
            "email": "info@zazu.berlin"
        }
     ],
	"license": "GPL-2.0-or-later",
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	},
	"repositories": [
		 {
	         "type": "path",
             "url": "./packages/*"
        },
		{
            "type": "vcs",
            "url": "https://bitbucket.org/thomas-hezel/bsggerapackage.git"
         }
	],
	"require": {
		"georgringer/news": "^12",
        "georgringer/numbered-pagination": "^2",
        "helhum/typo3-console": "^8",
        "lochmueller/sourceopt": "^5",
        "reelworx/rx-shariff": "^15",
		"t3/dce": "^3",
		"typo3/cms-backend": "^13.4",
		"typo3/cms-belog": "^13.4",
		"typo3/cms-beuser": "^13.4",
		"typo3/cms-core": "^13.4",
		"typo3/cms-dashboard": "^13.4",
		"typo3/cms-extbase": "^13.4",
		"typo3/cms-extensionmanager": "^13.4",
		"typo3/cms-felogin": "^13.4",
		"typo3/cms-filelist": "^13.4",
		"typo3/cms-fluid": "^13.4",
		"typo3/cms-fluid-styled-content": "^13.4",
		"typo3/cms-form": "^13.4",
		"typo3/cms-frontend": "^13.4",
		"typo3/cms-impexp": "^13.4",
		"typo3/cms-info": "^13.4",
		"typo3/cms-install": "^13.4",
		"typo3/cms-linkvalidator": "^13.4",
		"typo3/cms-lowlevel": "^13.4",
		"typo3/cms-reactions": "^13.4",
		"typo3/cms-redirects": "^13.4",
		"typo3/cms-rte-ckeditor": "^13.4",
		"typo3/cms-scheduler": "^13.4",
		"typo3/cms-seo": "^13.4",
		"typo3/cms-setup": "^13.4",
		"typo3/cms-sys-note": "^13.4",
		"typo3/cms-tstemplate": "^13.4",
		"typo3/cms-viewpage": "^13.4",
		"typo3/cms-webhooks": "^13.4",
		"zazuberlin/bsggerapackage": "dev-main"
	}
}
