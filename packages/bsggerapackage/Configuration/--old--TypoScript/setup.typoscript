######################
#### DEPENDENCIES ####
######################
@import 'EXT:fluid_styled_content/Configuration/TypoScript/setup.typoscript'

################
#### HELPER ####
################
@import 'EXT:bsggerapackage/Configuration/TypoScript/Helper/dynamicContent.typoscript'
@import 'EXT:bsggerapackage/Configuration/TypoScript/Helper/news.typoscript'


##################
#### TEMPORAL ####
##################
config {
//show errors on frontend - only in part where the error/plugin occcurs with = 1, full errors = 0
contentObjectExceptionHandler = 0
#preventing any revealing and space-consuming comments in the HTML source code
disablePrefixComment = 1
#If set then debug information in the TypoScript code is sent.
debug = 0
}

#############
##sourceopt##
#############
#formatHtml: 0 off, 1 no line breaks, 2 miniaml, 3 asthetic, 4 logic line breaks
config.sourceopt {
    enabled = 0
    formatHtml = 2
}



##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0
    shortcutIcon = EXT:bsggerapackage/Resources/Public/Icons/favicon.ico

    #id ins body-Tag
    bodyTag >
    bodyTagCObject = TEXT
    bodyTagCObject.dataWrap = <body id="p{page:uid}" itemscope itemtype="http://schema.org/localBusiness">

    // Part 1: Fluid template section
    10 = FLUIDTEMPLATE
    10 {
        # Template names will be generated automatically by converting the applied
        # backend_layout, there is no explicit mapping necessary anymore.
        # https://usetypo3.com/backend-layouts/
        #
        # BackendLayout Key
        # subnavigation_right_2_columns -> SubnavigationRight2Columns.html
        #
        # Backend Record
        # uid: 1 -> 1.html
        #
        # Database Entry
        # value: -1 -> None.html
        # value: pagets__subnavigation_right_2_columns -> SubnavigationRight2Columns.html
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                case = uppercamelcase
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }

        //second line is constants $page the "page-object-variable"
        templateRootPaths {
            0 = EXT:bsggerapackage/Resources/Private/Templates/Page/
            1 = {$page.fluidtemplate.templateRootPath}
        }

        partialRootPaths {
            0 = EXT:bsggerapackage/Resources/Private/Partials/Page/
            1 = {$page.fluidtemplate.partialRootPath}
        }

        layoutRootPaths {
            0 = EXT:bsggerapackage/Resources/Private/Layouts/Page/
            1 = {$page.fluidtemplate.layoutRootPath}
        }

        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
              levels = 3
              expandAll = 1
              includeSpacer = 1
              as = menuMain
            }
            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                special = list
                special.value = 1
                levels = 1
                as = justHome
            }
            30 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            30 {
                special = rootline
                special.range = 0|-1
                includeNotInMenu = 1
                as = menuBreadcrumb
            }
            40 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            40 {
                special = directory
                special.value = {$page.fluidtemplate.dataProcessing.40.special.value}
                levels = 3
                expandAll = 1
                includeSpacer = 1
                titleField = nav_title // title
                as = menuFooter
            }
            50 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            50 {
                special = directory
                special.value = {$page.fluidtemplate.dataProcessing.50.special.value}
                levels = 1
                titleField = nav_title // title
                as = menuMeta
            }
        }

    }

    meta {
        viewport = width=device-width, initial-scale=1
        description = {$page.meta.description}
        description {
            override.field = description
        }
        author = {$page.meta.author}
        author {
            override.field = author
        }
        keywords = {$page.meta.keywords}
        keywords {
            override.field = keywords
        }

        # OpenGraph Tags
        og:title {
            attribute = property
            field = title
        }
        og:site_name {
            attribute = property
            data = TSFE:tmpl|setup|sitetitle
        }
        og:description = {$page.meta.description}
        og:description {
            attribute = property
            field = description
        }
        og:image {
            attribute = property
            stdWrap.cObject = FILES
            stdWrap.cObject {
                references {
                    data = levelfield:-1, media, slide
                }
                maxItems = 1
                renderObj = COA
                renderObj {
                    10 = IMG_RESOURCE
                    10 {
                        file {
                            import.data = file:current:uid
                            treatIdAsReference = 1
                            width = 1280c
                            height = 720c
                        }
                        stdWrap {
                            typolink {
                                parameter.data = TSFE:lastImgResourceInfo|3
                                returnLast = url
                                forceAbsoluteUrl = 1
                            }
                        }
                    }
                }
            }
        }
    }

    // favicon from https://realfavicongenerator.net
    // favicon 32x32
    // icon.png 192x192
    // icon.svg 192x192
    headerData {
        20 = TEXT
        20.value (
            <link rel="icon" href="/favicon.ico" sizes="any">
            <link rel="icon" href="/icon.svg" type="image/svg+xml">
            <link rel="apple-touch-icon" href="icon.png">
            <link rel="manifest" href="site.webmanifest">
            <meta name="theme-color" content="#fafafa">
        )
    }

    // Part 2: CSS and JSfile inclusion

    includeCSSLibs {

    }

    includeCSS {
        package_layout = EXT:bsggerapackage/Resources/Public/Css/Src/04-default-layout.css
    }

    includeJSLibs {

    }

    includeJS {

    }

    includeJSFooterlibs {

    }

    #is provided by sitepackage Layout fluid-uri: jQuery = EXT:bsggerapackage/Resources/Public/JavaScript/Min/jquery-3.3.1.min.js

    includeJSFooter {

        package_scripts = EXT:bsggerapackage/Resources/Public/JavaScript/Src/package-site.js
    }

} #END PAGE OBJECT



################
#### CONFIG ####
################
config {
    # Remove Default CSS: Default CSS of extensions will be removed
    removeDefaultCss = 1
    #If this value is set, then all relative links in TypoScript are prepended with auto detect site root.
    absRefPrefix = auto
    #test caching not working, 86400 = 24 h
    cache_period = 86400
    doctype = html5
    renderCharset = utf-8
    metaCharset = utf-8
    #default is _top
    extTarget = _blank
    intTarget = _top
    index_enable = 1
    index_externals = 1
    index_metatags = 1
    #If set, the inline styles TYPO3 controls in the core are written to a file
    inlineStyle2TempFile = 1
    pageTitleFirst = 1
    uniqueLinkVars = 1
    linkVars = L
    #prefix not in documentation just from Kott
    prefixLocalAnchors = all
    debug = 0
    headerComment = zazu.berlin – DIGITAL+FILM unterstützt Open Source Systeme – Author: Thomas Hezel (©) 2023, urheberrechtlich geschützt
    // Disable image upscaling over the original size, not documented just from Kott
    noScaleUp = 1

    // Compression and concatenation of CSS and JS Files
    // only if they are included with TS "include", needs level in .htaccess
    // plus TYPO3 BE/FE Configure Installation wide options for compression level (1-9/7)
    compressCss = 0
    compressJs = 0
    concatenateCss = 0
    concatenateJs = 0

    //from the constants.typoscript or overwritten in constants editor BE
    no_cache = {$config.no_cache}
    removeDefaultJS = {$config.removeDefaultJS}
    admPanel = {$config.admPanel}
    sendCacheHeaders = {$config.sendCacheHeaders}
}


####################################
#### ADDITIONAL for the PACKAGE ####
####################################

# fluid_styled_content Layout Template now in sitepackage - get rid of numberd DIVs around news etc.
lib.contentElement.layoutRootPaths.10 = EXT:bsggerapackage/Resources/Private/Layouts/ContentElements/Fluid-Styled-Content


#site title in the title tag
config.noPageTitle = 2
page.headerData.5 = TEXT
page.headerData.5.field = subtitle  // title
page.headerData.5.wrap = <title>zazu.berlin prototype &nbsp; |</title>

config {
 #html TAG similar to boilerplate, lang="de" for html5 and xml:lang=de for svgs (since they are xml)
    htmlTag_stdWrap {
      setContentToCurrent = 1
      cObject = COA
      cObject {
        10 = TEXT
        10.value = class="no-js"
        10.noTrimWrap = | | |
        20 = TEXT
        20.value = lang="de" xmlns="http://www.w3.org/1999/xhtml"
        wrap = <html | >
       }
    }
}


#### html tag accordingly (language, locale_all is in the site yaml ######
[siteLanguage("languageId") == "0"]
config {
    htmlTag_stdWrap.cObject.20.value = lang="de" xmlns="http://www.w3.org/1999/xhtml"
}
[END]



[siteLanguage("languageId") == "1"]
config {
    htmlTag_stdWrap.cObject.20.value = lang="en" xmlns="http://www.w3.org/1999/xhtml"
}
[END]

############SEO additional news sitemap ###########
plugin.tx_seo.config {
    xmlSitemap {
        sitemaps {
            news {
                provider = TYPO3\CMS\Seo\XmlSitemap\RecordsXmlSitemapDataProvider
                config {
                    table = tx_news_domain_model_news
                    additionalWhere =
                    sortField = sorting
                    lastModifiedField = tstamp
                    changeFreqField = sitemap_changefreq
                    priorityField = sitemap_priority
                    #news folder
                    pid = 11
                    recursive = 2
                    url {
                        #news single view page
                        pageId = 9
                        fieldToParameterMap {
                            uid = tx_news_pi1[news]
                        }
                        additionalGetParameters {
                            tx_news_pi1.controller = News
                            tx_news_pi1.action = detail
                        }
                    }
                }
            }
        }
    }
}

