#######################
#### SPECIAL PAGES ####
#######################

################## Contact page - FORM extension ###########

plugin.tx_form {
    settings {
        yamlConfigurations {
            100 = EXT:bsggerapackage/Configuration/Form-yaml/form-setup.yaml
        }
    }
}

# adds the sitepackage to the possible places (next to fileadmin) to store and manage forms
module.tx_form {
    settings {
        yamlConfigurations {
            100 = EXT:bsggerapackage/Configuration/Form-yaml/form-setup.yaml
        }
    }
}




################## Home page - FlexSlider- News for one page ###########
[traverse(page, "uid") == {$globals.page.newsSlider}]
    page {

        includeCSS {
            file2 = EXT:bsggerapackage/Resources/Public/Ext/FlexSlider-2.7.2/flexslider.css
        }

        includeJSFooter {
            flexSliderJs = EXT:bsggerapackage/Resources/Public/Ext/FlexSlider-2.7.2/jquery.flexslider-min.js
        }

        900 = TEXT
        900.value (
            <script>
                //slider news Home
                $(document).ready(function() {
                    $('.flexslider').flexslider({
                       animation: "slide",
                       animationLoop: true,
                       pauseOnHover: true,
                       slideshow: false
                    });
                });
            </script>
        )
    }
[END]


