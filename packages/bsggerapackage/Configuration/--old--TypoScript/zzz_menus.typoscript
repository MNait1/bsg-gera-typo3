# TYPOSCRIPT Menues now just Archive new is Fluid-Menues
########## MAIN NAVIGATION ###########

temp.mainMenu = HMENU
temp.mainMenu {
    entryLevel = 0
    #wrap = <ul id="navSlide">|</ul> //is in fluid template

    1 = TMENU
    1 {
        expAll = 1
        noBlur = 1


        NO = 1
        NO {
            wrapItemAndSub = <li>|</li>
            linkWrap = <span class="borderLine">|</span>
            stdWrap.htmlSpecialChars = 0
            ATagTitle.field = title
        }

        CUR <.NO
        CUR {
            wrapItemAndSub = <li class="current">|</li>
        }

        ACT <.NO
        ACT {
            wrapItemAndSub = <li id="nav1act">|</li>
        }
    }

    2 < .1
    2 {
        wrap = <ul class="nav2 fallback">|</ul>
        ACT.wrapItemAndSub = <li id="nav2act">|</li>
    }

    3 < .2
    3 {
        wrap = <ul class="nav3 fallback">|</ul>
        ACT.wrapItemAndSub = <li id="nav3act">|</li>
    }

}


###### ROOTLINE NAVIGATION ######

temp.rootlineNav = HMENU
temp.rootlineNav {
    special = rootline

    # zeige komplette rootline an
    special.range = 1|-1

    # Variation: Link nur auf die uebergeordnete Seite
    #special.range = -2|-2

    # Text vor dem Rootline Menue
    wrap = <p>Sie sind hier: &nbsp;|</p>

    1 = TMENU
    1.target = _top
    1.NO {
        stdWrap.htmlSpecialChars = 0

        #  Layout 1: Seite 1 | Seite 2 | Seite 3
        linkWrap = |&nbsp;&raquo;&nbsp;|*||*| |

        doNotLinkIt = |*| 0 |*| 1
    }
}


####### in Page Nav DCE 102 #############

lib.inPageNav = HMENU
lib.inPageNav {
    stdWrap.htmlSpecialChars = 0
    special = directory
    special.value = 3
    entryLevel = -1
    1 = TMENU
    1.wrap = <ul id="inPageNav" class="clearfix"> | </ul>
    1.noBlur = 1

    1.NO.wrapItemAndSub = <li id="link{field:uid}">|</li>
    1.NO.wrapItemAndSub.insertData = 1
    1.CUR = 1
    1.CUR.linkWrap = <li class="inPageNavCur">|</li>
    1.CUR.doNotLinkIt = 1
}


############ Impressum Datenschutz ###########
#Meta Navigation im footer

temp.metaNav = HMENU
temp.metaNav {
    special = directory
    special.value = 15
    entryLevel = -1
    1 = TMENU
    1.wrap = <ul id="metaNavUl"> | </ul>
    1.noBlur = 1
    1.NO.linkWrap = <li>|</li>
    1.CUR = 1
    1.CUR.linkWrap = <li id="metaNavCur">|</li>
    1.CUR.doNotLinkIt = 1
}
