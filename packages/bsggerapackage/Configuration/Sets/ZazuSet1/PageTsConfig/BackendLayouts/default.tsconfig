#
# BACKENDLAYOUT: default 1 column main page style
#

mod {
    web_layout {
        BackendLayouts {
            default {
                title = LLL:EXT:bsggerapackage/Resources/Private/Language/locallang_be.xlf:backendLayout.default.title
                icon = EXT:bsggerapackage/Resources/Public/Icons/bel-1-col.png
                config {
                    backend_layout {
                        colCount = 1
                        rowCount = 1
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:bsggerapackage/Resources/Private/Language/locallang_be.xlf:backendLayout.default.columnName.colPos_0
                                        colPos = 0
                                        identifier = main
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
