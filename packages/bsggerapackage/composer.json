{
    "name": "zazuberlin/bsggerapackage",
    "type": "typo3-cms-extension",
    "description": "Sitepackage from zazu.berlin, based on fluid and the sets system.",
    "homepage": "https://zazu.berlin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Thomas Hezel",
            "role": "Developer",
            "email": "info@zazu.berlin"
        }
    ],
    "keywords": [
